{
  "name": "Codex Team — Private Preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:5.2.3-24-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "مساحة الفريق — معاينة خاصة",
      "onAutoForward": "openPreview",
      "protocol": "http"
    }
  },
  "postCreateCommand": "npm --prefix web ci --include=dev && npm run build",
  "postAttachCommand": "bash .devcontainer/start-preview.sh"
}
